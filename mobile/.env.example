# =============================================================================
# Mari Partner Fuel - Konfigurasi Lingkungan (Template Contoh)
# Salin file ini menjadi .env atau masukkan nilai ke local.properties.
# JANGAN PERNAH MENYIMPAN KUNCI ASLI ATAU SECRET DI SINI!
# =============================================================================

# Supabase Client (Publik untuk Android Client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_only

# Google OAuth Web Client ID (Dikonfigurasi di Google Cloud Console & Supabase Auth Provider)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Supabase Server-Side Secret (Hanya di Supabase Edge Function Secrets - BUKAN di Android)
# Sudah tersimpan aman di Supabase Secrets via Supabase CLI (npx supabase secrets set):
# - QRISPY_API_TOKEN
# - GEMINI_API_KEY
# - QRISPY_WEBHOOK_SECRET
# CATATAN KEAMANAN: Jangan simpan token/secret server di file .env lokal ini.
